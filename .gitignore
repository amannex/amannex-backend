# ==============================================================================
# Ignore WordPress Core & Root Files (Track only wp-content)
# ==============================================================================
/*

# Whitelist repository documentation & config
!/.gitignore
!/README.md

# Whitelist wp-content directory
!/wp-content/

# ==============================================================================
# Ignore Media, Uploads, Cache & Generated Content inside wp-content
# ==============================================================================
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backups/
wp-content/backup-db/
wp-content/blogs.dir/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php

# ==============================================================================
# Plugins Policy: Ignore 3rd-party plugins; track only custom plugins
# ==============================================================================
wp-content/plugins/*
!wp-content/plugins/index.php
# Whitelist custom plugins (e.g. prefixed with 'amannex-' or add specific folder names)
!wp-content/plugins/amannex-*/
!wp-content/plugins/custom-*/

# ==============================================================================
# Secrets, Environment & Logs
# ==============================================================================
wp-config.php
.env
.env.*
!.env.example
*.log
wp-content/debug.log
error_log

# ==============================================================================
# OS & Editor Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~
node_modules/
vendor/
